{
  "manifest_version": 3,
  "name": "Conversation Audio Processor",
  "version": "1.0",
  "description": "Extract conversations from LLM interfaces",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "chrome/popup.html"
  },
  "content_scripts": [
    {
      "matches":  ["<all_urls>"],
      "js": [
        "core/conversationModel.js",
        "core/voiceProfiles.js",
        "chrome/extractors/gemini.js",
        "content.js"
      ]
    }
  ]
}