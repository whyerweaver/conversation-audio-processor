{
  "manifest_version": 3,
  "name": "Conversation Audio Processor",
  "version": "1.0",
  "description": "Extract conversations from LLM interfaces",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches":  ["<all_urls>"],
      "js": [
        "conversationModel.js",
        "voiceProfiles.js",
        "gemini.js",
        "content.js"
      ]
    }
  ]
}