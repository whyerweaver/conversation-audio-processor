{
  "manifest_version": 3,
  "name": "Conversation Audio Processor",
  "version": "1.0",
  "description": "Process and analyze conversation audio",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}